{
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "debug.onTaskErrors": "showErrors",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src"
    ],
    "C_Cpp.default.compilerPath": "${workspaceFolder}/src",
    "git.openRepositoryInParentFolders": "always",
    "makefile.configureOnOpen": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "git.autofetch": true,
    "editor.formatOnSave": true,
    "window.autoDetectColorScheme": true,
    "editor.autoIndentOnPaste": true,
    "editor.formatOnPaste": true,
    "workbench.tree.indent": 32,
    "workbench.startupEditor": "none",
    "workbench.browser.enableChatTools": false,
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "editor.tabSize": 4,
    "workbench.settings.showAISearchToggle": false,
    "cmake.sourceDirectory": "/mnt/projects/bootpd",
    "files.autoSaveWorkspaceFilesOnly": true,
    "workbench.editor.showIcons": true,
    "workbench.productIconTheme": "Default",
    "workbench.accounts.showAvatar": false,
    "workbench.browser.enableRemoteProxy": false,
    "workbench.browser.experimentalUserTools.enabled": true,
    "workbench.editor.languageDetection": true,
    "workbench.activityBar.autoHide": true,
    "workbench.preferredDarkColorTheme": "Atom One Light",
    "workbench.preferredLightColorTheme": "Atom One Light",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "workbench.sideBar.location": "right",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.closeEmptyGroups": false,
    "workbench.editor.closeOnFileDelete": false,
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.labelFormat": "default",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabCloseButton": "on"

}
