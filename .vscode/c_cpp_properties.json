{
	"configurations": [
		        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/bootpd/src",
                "${workspaceFolder}/thirdparty",
                "${workspaceFolder}/plugins/DHCP/src"
            ],
            "defines": [
                "_DEBUG",
                "__linux__",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
	],
	"version": 4
}