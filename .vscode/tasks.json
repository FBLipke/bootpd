{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cmake",
      "label": "CMake: Configure",
      "command": "configure",
      "args": [
        "-G",
        "Visual Studio 17 2022",
        "-A",
        "x64"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Configure bootpd with CMake for Visual Studio"
    },
    {
      "type": "cmake",
      "label": "CMake: Build",
      "command": "build",
      "args": [
        "--config",
        "Debug"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build bootpd with CMake"
    },
    {
      "type": "shell",
      "label": "Clean Build Folder",
      "command": "if (Test-Path build) { Remove-Item -Recurse -Force build }",
      "problemMatcher": [],
      "group": "none",
      "detail": "Delete build folder before rebuild"
    },
    {
      "type": "shell",
      "label": "Full Rebuild",
      "command": "",
      "dependsOn": [
        "Clean Build Folder",
        "CMake: Configure",
        "CMake: Build"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Clean, configure and build bootpd"
    },
    {
      "type": "process",
      "command": "/usr/bin/env",
      "args": [
        "CC=clang",
        "CFLAGS=-g -Wall",
        "make",
        "${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "makelldb: selected file"
    }
  ]
}