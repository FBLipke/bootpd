{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cd build && cmake ..",
            "group": "build",
            "problemMatcher": [],
            "detail": "Run CMake configure"
        },
        {
            "label": "Build (Windows: Debug)",
            "type": "shell",
            "command": "${workspaceFolder}/build.cmd",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"],
            "detail": "Build bootpd using build.cmd (Windows Debug)"
        },
        {
            "label": "Build (Windows: Release)",
            "type": "shell",
            "command": "${workspaceFolder}/build.cmd Release",
            "group": "build",
            "problemMatcher": ["$msCompile"],
            "detail": "Build bootpd using build.cmd (Windows Release)"
        },
        {
            "label": "Build (Linux: Debug)",
            "type": "shell",
            "command": "mkdir -p build && cd build && cmake .. && make",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build bootpd on Linux (Debug)"
        },
        {
            "label": "Build (Linux: Release)",
            "type": "shell",
            "command": "mkdir -p build && cd build && cmake -DCMAKE_BUILD_TYPE=Release .. && make",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Build bootpd on Linux (Release)"
        },
        {
            "label": "Clean (Windows)",
            "type": "shell",
            "command": "if exist build ( rd /s /q build )",
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean build directory (Windows)"
        },
        {
            "label": "Clean (Linux)",
            "type": "shell",
            "command": "rm -rf build",
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean build directory (Linux)"
        }
    ]
}
